      .col-md-6
        img(src="/public/img/inicio_nosotros.jpg" alt="imagen de inicio nosotros" class="img-fluid")

    //- Viajes
    .viajes.mt-5
      h3.text-center Viajes
      .row.mt-3
        each viaje in viajes
          +Viaje(viaje)

    //- Descuento
    .mt-5
