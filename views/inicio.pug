extends ./layout/AppLayout
include ./mixins/viaje
include ./mixins/testimonial

block slider
  .slider
    h1 Rio de Janeiro
    em aventura

block contenido

  main.mt-5
    h3.text-center Sobre nosotros
    .row.mt-3
      .col-md-6
        p Lorem ipsum dolor sit amet consectetur adipisicing elit. Assumenda maxime sequi est molestiae, iusto dolores repellat dignissimos totam tempora ab molestias corrupti quidem nostrum omnis et excepturi consectetur iure fugit?
