              p.titulo Viaje a Canada
              p.fecha 20 de Marzo de 2022 - 28 de Marzo de 2022
              p.precio $2,500 USD


    //- Testimoniales
    .row.my-5
      .col-md-12
        h3.text-center Testimoniales
          .row.mt-3.justify-content-center
            each testimonial in testimoniales
              +Testimonial(testimonial)







